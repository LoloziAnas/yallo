# Copy to .env.production (or set in the build environment) when deploying the back office.
# Where the Yallo API lives. Leave unset to call the same origin and proxy /api there.
VITE_API_URL=https://api.yallo.ma
# Or, for the public demo: read the API's address at runtime from this file (see docs/DEMO.md),
# and serve the build from a sub-path.
# VITE_API_CONFIG=https://lolozianas.github.io/yallo/api.json
# VITE_BASE=/yallo/ops/
