# Environment for the Yallo API (all optional). See the "Production" section of the root CLAUDE.md.
PORT=5190
HOST=0.0.0.0
# Where state is kept; "off" keeps it in memory only.
STATE_FILE=/var/lib/yallo/state.json
# production: enforces auth and disables the dev tokens.
NODE_ENV=production
# Override the auth mode (enforce in production, warn otherwise).
# AUTH_MODE=enforce
# Browser origins allowed to call the API (mobile apps send none and are always allowed).
CORS_ORIGINS=https://ops.yallo.ma,https://app.yallo.ma
# Push notifications: expo (through Expo's push service) or log (default: only logged). PUSH= is the old name.
PUSH_DRIVER=expo
# EXPO_ACCESS_TOKEN=...
# Stand-ins (default: on in development, off in production): a store without the merchant app accepts and prepares
# orders by itself; a courier without the app accepts offers by itself.
STAND_IN_MERCHANT=off
STAND_IN_COURIERS=off
# The clock: real (default in production) follows the wall clock in TIME_ZONE; demo is the fixed evening from 18:34.
CLOCK=real
TIME_ZONE=Africa/Casablanca
# How sign-in codes are sent. Only "log" exists so far (codes go to the server log); see src/sms.ts to add one.
SMS_DRIVER=log
# Shown by /api/health.
YALLO_VERSION=1.0.0
# Behind a reverse proxy: rate-limit by X-Forwarded-For.
TRUST_PROXY=1
# Allow POST /api/reset (wipes all data). Off in production.
# ALLOW_RESET=1
# Outside production only: RATE_LIMITS=on to try the limits; OTP_MODE=random for real-looking codes.

# --- Public demo (see docs/DEMO.md) ---
# DEPLOY_PROFILE=demo: auth enforced, dev tokens off, every code 123456, reset by ops only, TRUST_PROXY on,
# real time with every store open, stand-in merchants and couriers, auto-dispatch, 6 tester couriers.
# DEPLOY_PROFILE=demo
# The demo's time zone (an IANA name or a fixed offset like +00:00). Check "time" in /api/health after deploying.
# DEMO_TIME_ZONE=Africa/Casablanca
# Keep the state in Postgres tables instead of STATE_FILE (schema: api/migrations, applied at start; one API process
# per database). Backups and restores: docs/BACKUP.md.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
