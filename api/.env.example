# Environment for the Yallo API (all optional). See the "Production" section of the root CLAUDE.md.
PORT=5190
HOST=0.0.0.0
# Where state is kept; "off" keeps it in memory only.
STATE_FILE=/var/lib/yallo/state.json
# production: enforces auth and disables the dev tokens.
NODE_ENV=production
# Override the auth mode (enforce in production, warn otherwise).
# AUTH_MODE=enforce
# Browser origins allowed to call the API (mobile apps send none and are always allowed).
CORS_ORIGINS=https://ops.yallo.ma,https://app.yallo.ma
# Real push notifications through Expo; anything else only logs them.
PUSH=expo
# EXPO_ACCESS_TOKEN=...
# Let the stand-in merchant accept and prepare orders (off when real merchants use the back office).
STAND_IN_MERCHANT=off
# Shown by /api/health.
YALLO_VERSION=1.0.0
