{
  "name": "yallo-api",
  "private": true,
  "version": "0.1.0",
  "description": "In-memory mock API shared by the Yallo apps: REST for actions, WebSocket for live state.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --external:ws --outfile=dist/server.mjs --log-level=warning",
    "start:prod": "NODE_ENV=production node dist/server.mjs"
  },
  "dependencies": {
    "@yallo/shared": "file:../shared",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
